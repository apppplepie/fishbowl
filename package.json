{
  "name": "fishbowl",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint",
    "db:init": "ts-node --project tsconfig.node.json scripts/init-db.ts",
    "db:seed": "ts-node --project tsconfig.node.json scripts/seed-data.ts",
    "db:migrate:drawing": "ts-node --project tsconfig.node.json scripts/add-drawing-type.ts",
    "db:migrate:tags": "ts-node --project tsconfig.node.json scripts/add-tags-table.ts",
    "db:migrate:author": "ts-node --project tsconfig.node.json scripts/add-author-id-field.ts",
    "db:migrate:access-level": "ts-node --project tsconfig.node.json scripts/update-users-table.ts",
    "db:rollback:galleries": "ts-node --project tsconfig.node.json scripts/remove-galleries-tables.ts",
    "db:fix:blocks": "ts-node --project tsconfig.node.json scripts/fix-blocks-content-size.ts"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.0.1",
