# 鏁版嵁搴撻厤缃?DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=test
DB_PORT=3306

# 鏁版嵁搴撹繛鎺ユ睜閰嶇疆锛堝彲閫夛級
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_WAIT_FOR_CONNECTIONS=true

# JWT 瀵嗛挜锛堢敤浜庤韩浠介獙璇侊級
JWT_SECRET=your-secret-key-change-in-production

# GPT content tools (v4)
# Reuse GPT_API_KEYS=key:userId or GPT_PUBLISH_TOKEN + GPT_AUTHOR_USER_ID.
GPT_SITE_URL=https://creepender.top
# Exact HTTPS image provider/CDN hostnames, comma-separated; empty disables remote imports.
GPT_IMAGE_ALLOWED_HOSTS=
